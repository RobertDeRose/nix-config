#!/usr/bin/env bash
# [MISE] description="Update Nix inputs transactionally, then upgrade the mise user layer"
# [MISE] interactive=true
#USAGE arg "[input]" help="Optional single flake input"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"
source "$root/.mise/lib/common.sh"
source "$root/.mise/lib/nix.sh"
load_nix_environment
configure_github_access_token
before="$(mktemp)"
cp flake.lock "$before"
# Invoked indirectly by the EXIT trap below.
# shellcheck disable=SC2329
restore_lock_on_failure() {
  local exit_status="$1"
  if [ "$exit_status" -ne 0 ]; then
    cp "$before" flake.lock
  fi
  rm -f "$before"
  trap - EXIT
  exit "$exit_status"
}
trap 'restore_lock_on_failure "$?"' EXIT
if [ -n "${usage_input:-}" ]; then
  nix_command flake update "$usage_input"
else
  nix_command flake update
fi
mise run check
mise run user:update
