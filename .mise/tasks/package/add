#!/usr/bin/env bash
# [MISE] description="Add and install a mise bootstrap package"
#USAGE arg "<package>" help="manager:package"
#USAGE flag "--macos" help="Write to the macOS user config"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
path="$root/config/mise/config.toml"
[ "${usage_macos:-false}" != true ] || path="$root/config/mise/config.macos-arm64.toml"
package="${usage_package:?mise did not provide the required package argument}"
exec mise bootstrap packages use --path "$path" --yes "$package"
