#!/usr/bin/env bash
# [MISE] description="Remove a mise bootstrap package declaration"
#USAGE arg "<package>" help="manager:package"
#USAGE flag "--macos" help="Edit the macOS user config"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
path="$root/config/mise/config.toml"
[ "${usage_macos:-false}" != true ] || path="$root/config/mise/config.macos-arm64.toml"
python3 "$root/.mise/lib/config_edit.py" package --file "$path" --name "${usage_package}" --remove
printf 'Removed %s from %s. The installed package was intentionally left in place.\n' "${usage_package}" "${path#$root/}"
