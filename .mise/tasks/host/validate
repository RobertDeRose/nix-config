#!/usr/bin/env bash
# [MISE] description="Validate users, hosts, systems, profiles, deployment paths, and overrides"
# [MISE] hide=true
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
source "$root/.mise/lib/common.sh"
cd "$root"
python3 "$root/.mise/lib/inventory.py" \
  --file "$root/inventory.toml" \
  --repo-root "$root" \
  validate
