#!/usr/bin/env bash
# [MISE] description="Converge user tools, applications, preferences, and dotfiles with mise"
# [MISE] interactive=true
#USAGE flag "--force-dotfiles" help="Replace conflicting whole-file targets"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"
args=(--yes)
prepare_args=()
if [ "${usage_force_dotfiles:-false}" = true ]; then
  args+=(--force-dotfiles)
  prepare_args+=(--force-dotfiles)
fi
mise trust "$root/mise.toml" >/dev/null
mise install
"$root/scripts/user-prepare.sh" "${prepare_args[@]}"
mise bootstrap --only dotfiles "${args[@]}"
"$root/scripts/user-link-mise-lock.sh"
(
  cd "$HOME"
  MISE_AUTO_ENV=true MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/config.toml" mise bootstrap --skip task "${args[@]}"
)
"$root/scripts/user-finalize.sh"
