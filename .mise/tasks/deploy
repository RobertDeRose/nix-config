#!/usr/bin/env bash
# [MISE] description="Deploy a Linux system with deploy-rs, then converge its mise user environment"
# [MISE] interactive=true
#USAGE arg "<host>" help="Linux inventory host"
#USAGE flag "--system-only" help="Skip repository transfer and remote user bootstrap"
#USAGE flag "--force-dotfiles" help="Replace conflicting remote user dotfiles"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"
source "$root/.mise/lib/common.sh"
source "$root/.mise/lib/inventory.sh"

host="${usage_host:?mise did not provide the required host argument}"
require_inventory_host "$root" "$host"
mise run system:deploy -- "$host"
[ "${usage_system_only:-false}" != true ] || exit 0

hostname="$(inventory_deploy_hostname "$root" "$host")"
ssh_user="$(inventory_deploy_ssh_user "$root" "$host")"
user="$(inventory_deploy_user_ssh_user "$root" "$host")"
repo_path="$(inventory_deploy_repo_path "$root" "$host")"
archive="$(mktemp "${TMPDIR:-/tmp}/maison-deploy.XXXXXX.tar.gz")"
trap 'rm -f "$archive"' EXIT

# Include .git so location-independent tasks can discover the repository root on
# the target. Exclude only generated state and build outputs.
tar \
  --exclude='./.build' \
  --exclude='./result' \
  --exclude='./result-*' \
  --exclude='./.direnv' \
  --exclude='./book' \
  -czf "$archive" -C "$root" .

remote_archive="/tmp/maison-deploy-${host}-$$.tar.gz"
quoted_archive="$(printf '%q' "$remote_archive")"
# The destination was shell-escaped with printf %q for intentional expansion
# into the remote command.
# shellcheck disable=SC2029
ssh "$ssh_user@$hostname" "cat > $quoted_archive" <"$archive"

quoted_repo="$(printf '%q' "$repo_path")"
quoted_user="$(printf '%q' "$user")"
# All expanded arguments were shell-escaped with printf %q above.
# shellcheck disable=SC2029
ssh "$ssh_user@$hostname" "sh -s -- $quoted_repo $quoted_user $quoted_archive" <<'REMOTE_ROOT'
set -eu
repo_path="$1"
managed_user="$2"
archive="$3"
staging="${repo_path}.next.$$"
previous="${repo_path}.previous"

if [ "$(id -u)" -eq 0 ]; then
  sudo_cmd=""
else
  command -v sudo >/dev/null 2>&1 || {
    echo "sudo is required to install the user repository" >&2
    exit 1
  }
  sudo_cmd="sudo"
fi

cleanup() {
  $sudo_cmd rm -f "$archive"
  $sudo_cmd rm -rf "$staging"
}
trap cleanup EXIT HUP INT TERM

$sudo_cmd rm -rf "$staging"
$sudo_cmd mkdir -p "$staging"
$sudo_cmd tar -xzf "$archive" -C "$staging"
$sudo_cmd chown -R "$managed_user" "$staging"
$sudo_cmd rm -rf "$previous"
if $sudo_cmd test -e "$repo_path"; then
  $sudo_cmd mv "$repo_path" "$previous"
fi
$sudo_cmd mv "$staging" "$repo_path"
trap - EXIT HUP INT TERM
$sudo_cmd rm -f "$archive"
REMOTE_ROOT

remote_args=()
[ "${usage_force_dotfiles:-false}" != true ] || remote_args+=(--force-dotfiles)
quoted_args=""
for arg in "${remote_args[@]}"; do
  quoted_args+=" $(printf '%q' "$arg")"
done
quoted_repo="$(printf '%q' "$repo_path")"
# The repository path and optional arguments were shell-escaped with printf %q.
# shellcheck disable=SC2029
ssh "$user@$hostname" "sh -s -- $quoted_repo$quoted_args" <<'REMOTE_USER'
set -eu
repo_path="$1"
shift
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
cd "$repo_path"
export MISE_TRUSTED_CONFIG_PATHS="$repo_path${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
mise trust "$repo_path/mise.toml" >/dev/null
mise run user:apply -- "$@"
REMOTE_USER
