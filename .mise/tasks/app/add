#!/usr/bin/env bash
# [MISE] description="Add and install a macOS Homebrew cask"
#USAGE arg "<cask>" help="Cask token"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
exec mise bootstrap packages use --path "$root/config/mise/config.macos-arm64.toml" --yes "brew-cask:${usage_cask}"
