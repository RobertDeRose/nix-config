#!/usr/bin/env bash
# [MISE] description="Remove a macOS Homebrew cask declaration"
#USAGE arg "<cask>" help="Cask token"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
package="brew-cask:${usage_cask:?mise did not provide the required cask argument}"
python3 "$root/.mise/lib/config_edit.py" package \
  --file "$root/config/mise/config.macos-arm64.toml" \
  --name "$package" \
  --remove
printf 'Removed %s from the macOS config. The installed application was intentionally left in place.\n' "$package"
