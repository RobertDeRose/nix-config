#!/usr/bin/env bash
# [MISE] description="Install contributor tooling, then validate topology, data, scripts, tests, and Nix outputs"
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)}"
cd "$root"

# Contributor tools are intentionally isolated from ordinary machine
# convergence. A check opts into that environment explicitly.
mise -E dev install
for task in data shell tests nix; do
  mise -E dev run "check:$task"
done
