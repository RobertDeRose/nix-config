#!/usr/bin/env bash
# [MISE] description="Validate and format-check the Nix flake"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"
source "$root/.mise/lib/common.sh"
source "$root/.mise/lib/nix.sh"
load_nix_environment
configure_github_access_token
export NIX_SUPPRESS_DIRTY_WARNING=true
nix_command flake metadata >/dev/null
nix_command flake check --all-systems --no-build
nix_command fmt -- --ci
