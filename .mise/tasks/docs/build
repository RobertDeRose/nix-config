#!/usr/bin/env bash
# [MISE] description="Build the mdBook documentation with the contributor tool environment"
set -euo pipefail
TASK_FILE="${BASH_SOURCE[0]}"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "$TASK_FILE")" rev-parse --show-toplevel)}"
cd "$REPO_ROOT"

mise -E dev install github:rust-lang/mdBook
mise -E dev exec -- mdbook build docs
