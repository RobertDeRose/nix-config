#!/usr/bin/env bash
# [MISE] description="Add and install a global mise tool"
#USAGE arg "<tool>" help="Backend-qualified tool name"
#USAGE arg "[version]" default="latest" help="Version"
set -euo pipefail
root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
version="${usage_version:-latest}"
config="$root/config/mise/config.toml"
tool="${usage_tool:?mise did not provide the required tool argument}"
python3 "$root/.mise/lib/config_edit.py" tool --file "$config" --name "$tool" --version "$version"
suffix="${tool##*@}"
if [[ "$tool" == *@* && "$suffix" != */* ]]; then
  install_spec="$tool"
else
  install_spec="${tool}@${version}"
fi
MISE_GLOBAL_CONFIG_FILE="$config" mise install "$install_spec"
